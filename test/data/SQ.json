        "inputtype": "Parameter",
        "category": "Constant",
        "datatype": "DOUBLE",
        "len": "-",
        "min": "0",
        "max": "10",
        "default": "2.454",
        "unit": "MJ.kg-1",
        "uri": ""
      },
      {
        "name": "deepLayerT",
